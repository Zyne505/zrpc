<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- HTTPS only; trust the system CA store only (user-added CAs are ignored).
         This stops "install this certificate" MITM tricks from reading the token. -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
